{
  "org": "flowscripter",
  "github_actions_integration_id": 15368,
  "codecov": {
    "integration_id": 254,
    "checks": [
      "codecov/patch",
      "codecov/project"
    ]
  },
  "ignore": {
    "winget-pkgs": "fork of microsoft/winget-pkgs"
  },
  "skip": {
    "homebrew-tap": "deliberate exception pending confirmation: no ruleset, auto-merge off; release workflows push to it"
  },
  "special": {
